# Public configuration only — never put secrets in a SPA build.
# AUTH_MODE: "local" (offline personas against scripts/local_api.py) or "cognito".
VITE_AUTH_MODE=local
VITE_API_BASE_URL=http://127.0.0.1:8080
# Cognito (AUTH_MODE=cognito)
VITE_COGNITO_DOMAIN=https://novabank-dev-xxxx.auth.us-east-2.amazoncognito.com
VITE_COGNITO_CLIENT_ID=
VITE_REDIRECT_URI=http://localhost:5173/callback
